{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(mkfs:*)",
      "Bash(dd:*)",
      "Bash(shutdown:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(eval:*)",
      "Bash(node -e:*)",
      "Bash(python -c:*)",

      "Edit(**/.git/**)",
      "Edit(**/.codebuddy/**)",
      "Edit(**/.workbuddy/**)",
      "Edit(**/.buddybridge/**)",
      "Edit(**/.mcp.json)",
      "Edit(**/.env*)",
      "Edit(**/APPROVED.md)",
      "Read(**/.env*)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/.codebuddy/**)",
      "Read(**/.workbuddy/**)",
      "Read(**/.buddybridge/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowLocalBinding": true
    }
  }
}
